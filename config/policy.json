{
    "timeout": 15,
    "strict_mode": true,
    "blocked_patterns": [
        "os.system",
        "subprocess.Popen",
        "requests.get",
        "open('/etc/",
        "open('~/.ssh",
        "socket.connect",
        "rm -rf",
        "/etc/",
        "/home/",
        "~/.ssh",
        ".env",
        "id_rsa"
    ],
    "memory_limit_mb": 100,
    "keep_sandbox": true
}