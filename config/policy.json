{
    "timeout": 15,
    "strict_mode": true,
    "blocked_patterns": [
        "os.system",
        "subprocess.Popen",
        "requests.get",
        "open('/etc/",
        "open('~/.ssh",
        "socket.connect",
        "rm -rf",
        "/etc/",
        "/home/",
        "~/.ssh",
        ".env",
        "id_rsa"
    ],
    "memory_limit_mb": 100,
    "pids_limit": 20,
    "cpu_quota": 50000,
    "cpu_period": 100000,
    "keep_sandbox": true,
    "rootfs_path": "/tmp/argus-root",
    "enable_chroot": true,
    "enable_seccomp": true,
    "seccomp_profile": "no-network"
}